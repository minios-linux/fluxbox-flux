+// EWMH strut geometry. Distributed under the Fluxbox MIT license (COPYING).
+#ifndef EWMHSTRUT_HH
+#define EWMHSTRUT_HH
+
+#include <algorithm>
+
+namespace EwmhStrut {
+
+// The property uses root coordinates, not offsets from the panel's monitor.
+// Use wide arithmetic: X CARDINAL values can reach UINT32_MAX on i386 too.
+inline int edge(unsigned long depth, unsigned long start, unsigned long end,
+                int root_size, int offset, int size,
+                int cross_offset, int cross_size, bool far_edge) {
+    if (!depth || start > end || root_size <= 0 || size <= 0 || cross_size <= 0
+        || static_cast<long long>(end) < cross_offset
+        || static_cast<long long>(start) >= static_cast<long long>(cross_offset) + cross_size)
+        return 0;
+    const long long d = std::min(depth, static_cast<unsigned long>(root_size));
+    const long long amount = far_edge
+        ? static_cast<long long>(offset) + size - (root_size - d)
+        : d - offset;
+    return static_cast<int>(std::max(0LL, std::min(amount, static_cast<long long>(size))));
+}
+
+inline void clamp(int width, int height, int (&area)[4]) {
+    // Keep malformed or mutually overlapping reservations from underflowing
+    // the unsigned window sizes used by the maximization code.
+    area[0] = std::min(area[0], std::max(0, width - 1));
+    area[1] = std::min(area[1], std::max(0, width - area[0] - 1));
+    area[2] = std::min(area[2], std::max(0, height - 1));
+    area[3] = std::min(area[3], std::max(0, height - area[2] - 1));
+}
+
+inline void partial(const unsigned long *v, int root_width, int root_height,
+                    int x, int y, int width, int height, int (&area)[4]) {
+    area[0] = edge(v[0], v[4], v[5], root_width, x, width, y, height, false);
+    area[1] = edge(v[1], v[6], v[7], root_width, x, width, y, height, true);
+    area[2] = edge(v[2], v[8], v[9], root_height, y, height, x, width, false);
+    area[3] = edge(v[3], v[10], v[11], root_height, y, height, x, width, true);
+    clamp(width, height, area);
+}
+
+} // namespace EwmhStrut
+#endif
