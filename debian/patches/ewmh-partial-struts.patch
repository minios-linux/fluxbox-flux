+    BScreen &screen = winclient.screen();
+    unsigned long values[12] = {0};
+    Strut *strut = 0;
+    if (readStrut(winclient, m_net->wm_strut_partial, values, 12)) {
+        // A single panel may span several heads. Reserve only the intersecting
+        // edges and link all reservations to the client for replacement/cleanup.
+        const int heads = std::max(1, screen.numHeads());
+        for (int head = 1; head <= heads; ++head) {
+            int area[4];
+            EwmhStrut::partial(values, screen.width(), screen.height(),
+                              screen.getHeadX(head), screen.getHeadY(head),
+                              screen.getHeadWidth(head), screen.getHeadHeight(head), area);
+            if (area[0] || area[1] || area[2] || area[3])
+                strut = screen.requestStrut(head, area[0], area[1], area[2], area[3], strut);
+        }
+    } else if (readStrut(winclient, m_net->wm_strut, values, 4)) {
+        // Preserve the legacy head-local behavior for clients without PARTIAL.
+        const int head = screen.getHead(winclient);
+        const int width = screen.getHeadWidth(head), height = screen.getHeadHeight(head);
+        int area[4] = {
+            static_cast<int>(std::min(values[0], static_cast<unsigned long>(width))),
+            static_cast<int>(std::min(values[1], static_cast<unsigned long>(width))),
+            static_cast<int>(std::min(values[2], static_cast<unsigned long>(height))),
+            static_cast<int>(std::min(values[3], static_cast<unsigned long>(height)))
+        };
+        EwmhStrut::clamp(width, height, area);
+        strut = screen.requestStrut(head, area[0], area[1], area[2], area[3]);
+    }
+    // Install the new reservations before removing the old ones. Also handles
+    // deleted/zero/invalid properties, without an intermediate full-screen area.
+    winclient.setStrut(strut);
+    screen.updateAvailableWorkspaceArea();
+}
+
+void Ewmh::updateScreenSize(BScreen &screen) {
+    const list<Focusable *> clients = screen.focusControl().creationOrderList().clientList();
+    for (list<Focusable *>::const_iterator it = clients.begin(); it != clients.end(); ++it) {
+        WinClient *client = dynamic_cast<WinClient *>(*it);
+        if (client)
+            updateStrut(*client);
+    }
+    updateGeometry(screen);
+    updateWorkarea(screen);
+}
 
