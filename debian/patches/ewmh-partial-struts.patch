+// Read the complete property, validate its type and length, and always free
+// Xlib's allocation (32-bit properties are returned as native unsigned longs).
+bool readStrut(WinClient &client, Atom atom, unsigned long *values, unsigned long count) {
+    Atom type = None;
+    int format = 0;
+    unsigned long items = 0, remaining = 0;
+    unsigned char *raw = 0;
+    const bool success = client.property(atom, 0, count, False, XA_CARDINAL,
+                                         &type, &format, &items, &remaining, &raw);
+    const bool valid = success && raw && type == XA_CARDINAL && format == 32
+                       && items == count && remaining == 0;
+    if (valid)
+        std::copy(reinterpret_cast<unsigned long *>(raw),
+                  reinterpret_cast<unsigned long *>(raw) + count, values);
+    if (raw)
+        XFree(raw);
+    return valid;
+}
 
